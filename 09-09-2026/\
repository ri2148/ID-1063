#include<stdio.h>
#include<string.h>

//The search function
int search(char *word[], char *alphabet, int n){
for(int i=0; i<n; i++){
if(word[i]==alphabet){
break;
return i;
}
else{
continue;
}

}
return -1;}

//Main program begins
int main(void){

char word[100];
char alphabet='\0'; //Initialising the input variables

//Taking the input
printf("Enter a word: ");
fgets(word, sizeof(word), stdin);
word[strcspn(word, "\n")]='\0';
printf("Enter the character to search: ");
scanf(" %c", &alphabet);
int n=sizeof(word)/sizeof(word[0]); // To find the length of string
int output=search(&word[100], &alphabet, n);

//Printing the output
if(output>=0){
printf("Output: %d", n);
}
else{
printf("Output: -1");
}
}

